{
  "manifest_version": 3,
  "name": "Inbox Zero Whisper",
  "version": "0.1.2",
  "description": "Inbox Zero Whisper streamlines Gmail with on-device AI: 5-bullet summaries, three smart reply drafts, and one-tap proofreading. Privacy-first (no servers), resilient offline, and a draggable quick-action button that opens a clean side panel.",
  "permissions": ["activeTab", "tabs", "storage", "sidePanel"],
  "host_permissions": ["https://mail.google.com/*", "https://outlook.office.com/*"],
  "background": { "service_worker": "bg/worker.js" },
  "content_scripts": [{
    "matches": ["https://mail.google.com/*", "https://outlook.office.com/*"],
    "js": ["content/injector.js"],
    "run_at": "document_idle"
  }],
  "side_panel": { "default_path": "ui/panel.html" },
  "action": {
    "default_title": "Inbox Zero Whisper",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "ui/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-129.png"
  }
}
